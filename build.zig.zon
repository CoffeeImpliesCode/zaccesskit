.{
    // Package name. Consumers depend on this project as `zaccesskit`.
    .name = .zaccesskit,
    .version = "0.0.0",
    // Together with the name, this is the globally unique package identifier.
    // Zig generates it once and it never changes afterwards.
    .fingerprint = 0x95d7536e8599701b, // Changing this has security and trust implications.
    // Zig 0.16.0 is the line this project targets, not merely a lower bound.
    // `zig` on this host is an anyzig shim that reads this field, so it is also
    // how the toolchain gets selected: every tool in the gate follows it.
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        // zio is the async runtime this port is built around: it replaces the
        // tokio runtime that the Rust accesskit crates depend on. Pinned to the
        // tip of `main` at 2662fdc45997611b962b560c513c16963475a01b — the
        // commit `docs/20-zio-and-zig-io.md` was researched against. The hash
        // is taken from that tree, so a moving `main` fails the build instead of
        // drifting underneath us.
        //
        // A codeload tarball rather than `git+` because this host's libgit2
        // cannot negotiate with GitHub; `devenv.nix` records the same commit.
        //
        // Fetched from `lalinsky/zio`, the upstream author, not from a fork
        // account. The same commit is reachable from both, and the contents are
        // identical, so the choice costs nothing and keeps the pin auditable
        // against the account that owns the project. See
        // `docs/21-licensing.md`, which records that a fork carries no asserted
        // licence of its own.
        .zio = .{
            .url = "https://codeload.github.com/lalinsky/zio/tar.gz/2662fdc45997611b962b560c513c16963475a01b",
            // Computed by `zig build` from the tree the URL resolves to.
            .hash = "zio-0.18.0-xHbVVNWuKgDuxgpeptynAPuUOVIn2sXbgcqRhtiYn-rk",
        },
    },
    // Only these paths are packaged and hashed. Keep it to what a build needs.
    //
    // `test`, `include` and `tools` are here because three declared steps read
    // them, and `.paths` is the only place that says so. The `test` step
    // compiles `fuzz_root.zig`, which reaches `test/fuzz/` and embeds
    // `include/zaccesskit.h`, so a copy without either of them cannot run its
    // own gate. The `capi-parity` step is rooted at
    // `tools/capi_parity/main.zig`. `fuzz_root.zig` is its own entry because a
    // file at the repository root is named by itself and not by a directory
    // that holds it.
    //
    // What a consumer receives grows by about 0.6 megabytes: the harness and
    // its corpus, the header the harness measures, and the parity tool. A
    // dependent that imports the module compiles none of it, so the cost is
    // download size and nothing else.
    //
    // `.paths` is not the package fingerprint, which is the name and the
    // version, so widening it breaks no existing dependent.
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "test",
        "tools",
        "include",
        "docs",
        "README.md",
        "AGENTS.md",
        "fuzz_root.zig",
    },
}
