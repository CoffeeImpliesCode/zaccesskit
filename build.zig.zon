.{
    // Package name. Consumers depend on this project as `zaccesskit`.
    .name = .zaccesskit,
    .version = "0.0.0",
    // Together with the name, this is the globally unique package identifier.
    // Zig generates it once and it never changes afterwards.
    .fingerprint = 0x95d7536e8599701b, // Changing this has security and trust implications.
    // Zig 0.16.0 is the line this project targets, not merely a lower bound.
    // `zig` on this host is an anyzig shim that reads this field, so it is also
    // how the toolchain gets selected: every tool in the gate follows it.
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        // zio is the async runtime this port is built around: it replaces the
        // tokio runtime that the Rust accesskit crates depend on. Pinned to the
        // tip of `main` at 2662fdc45997611b962b560c513c16963475a01b — the
        // commit `docs/20-zio-and-zig-io.md` was researched against. The hash
        // is taken from that tree, so a moving `main` fails the build instead of
        // drifting underneath us.
        //
        // A codeload tarball rather than `git+` because this host's libgit2
        // cannot negotiate with GitHub; `devenv.nix` records the same commit.
        //
        // Fetched from `lalinsky/zio`, the upstream author, not from a fork
        // account. The same commit is reachable from both, and the contents are
        // identical, so the choice costs nothing and keeps the pin auditable
        // against the account that owns the project. See
        // `docs/21-licensing.md`, which records that a fork carries no asserted
        // licence of its own.
        .zio = .{
            .url = "https://codeload.github.com/lalinsky/zio/tar.gz/2662fdc45997611b962b560c513c16963475a01b",
            // Computed by `zig build` from the tree the URL resolves to.
            .hash = "zio-0.18.0-xHbVVNWuKgDuxgpeptynAPuUOVIn2sXbgcqRhtiYn-rk",
        },

        // zigwin32 is the whole UI Automation, Win32, COM and `oleaut32`
        // type boundary of the Windows adapter, and it is rung 2 of the
        // binding ladder in `AGENTS.md` section 2. Pinned to commit
        // 9f15c276b4e9d05afd34a10d8662a7dfc34647ea, the tree
        // `docs/42-native-adapter-build-map.md` section 2.1 checked against
        // the source. Its `.name` is `.win32`, so the module reaches source
        // as `@import("win32")`.
        //
        // Why the standard library is not enough:
        // `docs/42` section 2.1.4 records that `lib/std` has no `com.zig` and
        // no UI Automation module, so both `std.com` and every one of the
        // 10179 lines of `win32/ui/accessibility.zig` would have to be
        // written by hand. Section 2.1.2 records that zigwin32's `build.zig`
        // declares one module and opens no header, so it does not need a
        // Windows SDK to be fetched.
        //
        // Fetched from `marlersoft/zigwin32`, the account that owns the
        // project, so the pin stays auditable against the upstream author.
        .win32 = .{
            .url = "https://codeload.github.com/marlersoft/zigwin32/tar.gz/9f15c276b4e9d05afd34a10d8662a7dfc34647ea",
            // Computed by `zig build` from the tree the URL resolves to.
            .hash = "win32-42.0.39-preview-mX5pFS564gPTezZn4v3TMxRnfJUrZNx1B_F2p2HKXOeG",
        },
    },
    // Only these paths are packaged and hashed. Keep it to what a build needs.
    //
    // Tests, the C consumer and tools must also work from a packaged copy.
    // Repository-level roots keep their relative src/ imports inside the package.
    // A dependent that imports only the Zig module compiles none of the harnesses.
    //
    // `.paths` is not the package fingerprint, which is the name and the
    // version, so widening it breaks no existing dependent.
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "test",
        "tools",
        "include",
        "docs",
        "README.md",
        "AGENTS.md",
        "fuzz_root.zig",
        "capi_root.zig",
        "integration_root.zig",
        "reference_root.zig",
        "consumer_bench_root.zig",
        // `.ziglint.zon` is here because a packaged copy runs the same gate.
        // Without it the copy has Z001 enabled and reports all 498 C ABI
        // exports, so the exemption would hold for this checkout and not for
        // anything built from the package.
        ".ziglint.zon",
    },
}
